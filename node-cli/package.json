{
  "name": "@ghostcrawl/cli",
  "version": "2.4.0",
  "description": "GhostCrawl command-line interface",
  "homepage": "https://github.com/ghostcrawl/ghostcrawl",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ghostcrawl/ghostcrawl.git",
    "directory": "sdks/node-cli"
  },
  "bugs": {
    "url": "https://github.com/ghostcrawl/ghostcrawl/issues"
  },
  "author": "GhostCrawl, LLC",
  "keywords": [
    "ghostcrawl",
    "cli",
    "scrape",
    "crawl",
    "extract",
    "browser"
  ],
  "type": "module",
  "bin": {
    "ghostcrawl": "dist/index.js"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/index.js",
    "prepublishOnly": "npm run build && npm test",
    "test": "vitest run",
    "test:parity": "vitest run --config vitest.parity.config.ts"
  },
  "dependencies": {
    "@ghostcrawl/sdk": "^2.4.0",
    "commander": "^14.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "license": "MIT"
}
